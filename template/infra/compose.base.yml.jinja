{%- if 'backend' in modules -%}
x-backend-env: &backend-env
  DATABASE_URL: postgresql+psycopg://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@${POSTGRES_HOST:-db}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-service}
  ASYNC_DATABASE_URL: postgresql+asyncpg://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@${POSTGRES_HOST:-db}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-service}
  REDIS_URL: ${REDIS_URL:-redis://redis:6379}

{% endif -%}
name: ${COMPOSE_PROJECT_NAME:-{{ project_slug }}}

# Do not declare custom networks here. Codegen sibling workers replace the
# implicit default network with their pre-created dev network.
services:
{%- if 'backend' in modules %}
  backend:
    image: ${BACKEND_IMAGE:-{{ project_slug }}-backend:latest}
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    build:
      context: ..
      dockerfile: services/backend/Dockerfile
      args:
        INSTALL_DEV_DEPS: ${BACKEND_INSTALL_DEV_DEPS:-false}
    env_file:
      - ../.env
    environment:
      <<: *backend-env
    command: ["services/backend/scripts/start.sh"]
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"]
      interval: 5s
      timeout: 3s
      retries: 10
      start_period: 15s
{%- endif %}
{%- if 'tg_bot' in modules %}
  tg_bot:
    image: ${TG_BOT_IMAGE:-{{ project_slug }}-tg:latest}
    user: "${HOST_UID:-1000}:${HOST_GID:-1000}"
    build:
      context: ..
      dockerfile: services/tg_bot/Dockerfile
    env_file:
      - ../.env
    depends_on:
      redis:
        condition: service_healthy
{%- if 'backend' in modules %}
      backend:
        condition: service_started
{%- endif %}
{%- endif %}
{%- if 'backend' in modules %}

  db:
    image: postgres:16
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-service}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB" ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s
    volumes:
      - db_data:/var/lib/postgresql/data
{%- endif %}
{%- if 'backend' in modules or 'tg_bot' in modules %}

  redis:
    image: redis:7-alpine
    healthcheck:
      test: [ "CMD", "redis-cli", "ping" ]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s
{%- endif %}
{%- if 'backend' in modules %}

volumes:
  db_data:
{%- endif %}
