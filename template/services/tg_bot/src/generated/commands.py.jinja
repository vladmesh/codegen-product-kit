"""Core Telegram command registry: the only place the bot registers commands and input.

Built-in, product and bound module commands come from the validated host contract, in this
order, and unknown commands or text are answered by core in the core ``language`` setting.
Declare a product command as ``ProductCommand("name", handler)`` in ``COMMANDS`` of
``services/tg_bot/src/commands.py`` and run ``make generate-from-spec``; product CI fails when
this file and the declarations disagree.
"""

from __future__ import annotations

from collections.abc import Callable, Coroutine, Mapping
from dataclasses import dataclass
import importlib
from typing import Any

from telegram import Update
from telegram.ext import (
    CallbackQueryHandler,
    CommandHandler,
    MessageHandler,
    TypeHandler,
    filters,
)

REGISTRY_VERSION = 1
LANGUAGE_KEY = "language"
LANGUAGES = ("ru", "en")
PRODUCT_MODULE = "services.tg_bot.src.commands"
COMMANDS: tuple[dict[str, str], ...] = (
    {
        "command": "start",
        "owner": "core",
        "source": "services/tg_bot/src/main.py",
    },
{% if 'backend' in modules %}    {
        "command": "command",
        "owner": "core",
        "source": "services/tg_bot/src/main.py",
    },
{% endif %})
UNKNOWN = {
    "ru": "Не понимаю это сообщение. Доступные команды: {commands}",
    "en": "I don't understand this message. Available commands: {commands}",
}

Handler = Callable[[Any, Any], Coroutine[Any, Any, None]]


@dataclass(frozen=True)
class ProductCommand:
    """One product-owned Telegram command, declared in ``COMMANDS`` of the product module."""

    name: str
    handler: Handler


class CommandRegistryError(RuntimeError):
    """The running bot disagrees with the validated command registry."""


def owned_by(owner: str) -> list[str]:
    """Return the registry's commands of one owner, in registration order."""
    return [item["command"] for item in COMMANDS if item["owner"] == owner]


def module_commands() -> list[str]:
    return [item["command"] for item in COMMANDS if item["owner"].startswith("package:")]


def product_handlers() -> dict[str, Handler]:
    """Load product handlers and refuse any declaration the registry does not hold."""
    try:
        module = importlib.import_module(PRODUCT_MODULE)
    except ModuleNotFoundError as error:
        if error.name != PRODUCT_MODULE:
            raise
        declared: list[Any] = []
    else:
        declared = list(getattr(module, "COMMANDS", ()))
    if any(not isinstance(item, ProductCommand) for item in declared):
        raise CommandRegistryError("product COMMANDS entries must be ProductCommand values")
    if [item.name for item in declared] != owned_by("product"):
        raise CommandRegistryError(
            "product commands differ from the generated registry; run make generate-from-spec"
        )
    return {item.name: item.handler for item in declared}


class _ModuleApplication:
    """Admit exactly the registry's module commands from the generated bindings, in order."""

    def __init__(self, application: Any, expected: list[str]) -> None:
        self._application = application
        self._expected = expected
        self.bot_data = application.bot_data

    def add_handler(self, handler: Any, group: int = 0) -> None:
        if isinstance(handler, CommandHandler):
            if sorted(handler.commands) != self._expected[:1]:
                raise CommandRegistryError(
                    f"module command {sorted(handler.commands)} is not the next registry entry"
                )
            self._expected.pop(0)
        elif not isinstance(handler, CallbackQueryHandler) or group != 0:
            raise CommandRegistryError("module bindings may register only commands and callbacks")
        self._application.add_handler(handler, group)

    def finish(self) -> None:
        if self._expected:
            raise CommandRegistryError(f"module commands were not registered: {self._expected}")


async def language(client_factory: Any) -> str | None:
    """Read the core product language through the settings API; None when unavailable."""
    if client_factory is None:
        return None
    try:
        async with client_factory() as client:
            response = await client._request(
                "post",
                "/settings/get",
                json={"contract_version": 1, "key": LANGUAGE_KEY, "scope": "product"},
            )
            response.raise_for_status()
            value = response.json().get("value")
    except Exception:
        return None
    return value if isinstance(value, str) and value in LANGUAGES else None


def unknown_reply(selected: str | None) -> str:
    """Answer unknown input in the core language, or in both when it is not set."""
    commands = ", ".join(f"/{item['command']}" for item in COMMANDS)
    if selected is not None and selected in LANGUAGES:
        return UNKNOWN[selected].format(commands=commands)
    return "\n".join(UNKNOWN[locale].format(commands=commands) for locale in LANGUAGES)


def register(
    application: Any,
    *,
    access: Handler,
    builtins: Mapping[str, Handler],
    bindings: Any,
    client_factory: Any = None,
) -> None:
    """Register access, every registry command and the core unknown-input fallback."""
    if sorted(builtins) != sorted(owned_by("core")):
        raise CommandRegistryError(f"core built-ins must be exactly {owned_by('core')}")
    handlers = {**builtins, **product_handlers()}
    application.add_handler(TypeHandler(Update, access), group=-1)
    for item in COMMANDS:
        if item["owner"] in ("core", "product"):
            application.add_handler(CommandHandler(item["command"], handlers[item["command"]]))
    modules = _ModuleApplication(application, module_commands())
    bindings.register(modules, client_factory)
    modules.finish()

    async def unknown(update: Any, context: Any) -> None:
        if update.effective_message is not None:
            await update.effective_message.reply_text(unknown_reply(await language(client_factory)))

    application.add_handler(MessageHandler(filters.TEXT | filters.COMMAND, unknown))
