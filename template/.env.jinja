# {{ project_name }} — Development Environment
# Auto-generated by copier. Edit freely; copier update won't overwrite.

# Set a unique Compose project name when running multiple generated projects
# on the same Docker host.
# COMPOSE_PROJECT_NAME={{ project_slug }}-dev
{% if 'backend' in modules %}
APP_NAME={{ project_name }}
APP_ENV=development
APP_SECRET_KEY=please-change-me-in-production
# Local-only fixture for POST /users/grant. Deployment replaces this through
# the typed generated-secret resolver.
USERS_GRANT_CAPABILITY=local-grant-capability-not-for-production
# Local-only fixture for POST /settings/set. Deployment replaces this through
# the typed generated-secret resolver.
SETTINGS_WRITE_CAPABILITY=local-settings-capability-not-for-production
DEBUG=true

BACKEND_PORT=8000
POSTGRES_HOST_PORT=5432
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB={{ project_slug }}
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_REQUIRE_SSL=false
{% endif %}
{%- if 'backend' in modules or 'tg_bot' in modules or 'notifications' in modules %}
REDIS_HOST_PORT=6379
REDIS_URL=redis://redis:6379
{% endif %}
{%- if 'backend' in modules and ('tg_bot' in modules or 'notifications' in modules) %}
BACKEND_API_URL=http://backend:8000
{% endif %}
{%- if 'tg_bot' in modules %}
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
{% endif %}
{%- if 'backend' in modules %}
BACKEND_IMAGE={{ project_slug }}-backend:latest
{% endif %}
{%- if 'tg_bot' in modules %}
TG_BOT_IMAGE={{ project_slug }}-tg:latest
{% endif %}
{%- if 'notifications' in modules %}
NOTIFICATIONS_WORKER_IMAGE={{ project_slug }}-notifications:latest
{% endif %}
{%- if 'frontend' in modules %}
FRONTEND_IMAGE={{ project_slug }}-frontend:latest
FRONTEND_PORT=4321
{% endif %}
