"""Finite product-owned commands. No binding files or expressions are read at runtime."""

from collections import OrderedDict
from datetime import UTC, datetime, timedelta
import json
import re
from secrets import token_urlsafe
import time
from urllib.parse import quote
from typing import Any
from zoneinfo import ZoneInfo

from jsonschema import Draft202012Validator, FormatChecker
from telegram import InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import CallbackQueryHandler, CommandHandler

{{ imports }}

DATA = json.loads({{ data }})
PARSERS = {{ parsers }}
CONTEXT_TTL = 600
MAX_CONTEXTS = 1024
MAX_CONTEXT_BYTES = 65536
MAX_TEXT = 4000
STALE_REPLY = "This selection expired, was already used, or belongs to another user/chat. Run the command again."
ERROR_REPLY = "The backend could not confirm this operation. Check configuration/access and list your items before retrying."
MONTHS = ("January", "February", "March", "April", "May", "June", "July", "August",
          "September", "October", "November", "December")


class BindingRuntimeError(ValueError):
    pass


def bounded(value: str) -> str:
    return value.encode("utf-16-le", errors="replace")[:MAX_TEXT * 2].decode("utf-16-le", errors="ignore")


def aware(value: str) -> datetime:
    instant = datetime.fromisoformat(value.replace("Z", "+00:00"))
    if instant.utcoffset() is None:
        raise BindingRuntimeError("The backend returned an invalid time.")
    return instant


def preset_at(preset: dict[str, Any], now: datetime, zone: ZoneInfo) -> str:
    if now.utcoffset() is None:
        raise BindingRuntimeError("An aware clock is required.")
    if preset["kind"] == "offset":
        return (now.astimezone(UTC) + timedelta(seconds=preset["seconds"])).isoformat()
    local = now.astimezone(zone)
    wall = datetime.combine(local.date() + timedelta(days=preset["days"]),
                            datetime.strptime(preset["time"], "%H:%M").time())
    candidates = {
        candidate.astimezone(UTC)
        for fold in (0, 1)
        if (candidate := wall.replace(tzinfo=zone, fold=fold)).astimezone(UTC)
        .astimezone(zone).replace(tzinfo=None) == wall
    }
    if len(candidates) != 1:
        raise BindingRuntimeError("That local time is ambiguous or does not exist. Choose another time.")
    return candidates.pop().isoformat()


def reference(source: str, contexts: dict[str, Any]) -> Any:
    name, _, field = source[1:].partition(".")
    return contexts[name][field] if field else contexts[name]


def render(reply: dict[str, Any], contexts: dict[str, Any], zone: ZoneInfo | None = None) -> str:
    pieces = []
    for part in reply["parts"]:
        if isinstance(part, str):
            pieces.append(part)
        else:
            value = reference(part["source"], contexts)
            if part["format"] == "month_word":
                if zone is None:
                    raise BindingRuntimeError("The product timezone is required for this reply.")
                local = aware(value).astimezone(zone)
                value = f"{local.day} {MONTHS[local.month - 1]} {local.year} at {local:%H:%M %Z}"
            pieces.append(str(value))
    return bounded("".join(pieces))


def check(schema: dict[str, Any], value: Any) -> None:
    Draft202012Validator(schema, format_checker=FormatChecker()).validate(value)


class ChannelBindings:
    def __init__(self, client_factory: Any, clock: Any = None, monotonic: Any = None) -> None:
        self.client_factory = client_factory
        self.clock = clock or (lambda: datetime.now(UTC))
        self.monotonic = monotonic or time.monotonic
        self.pending: OrderedDict[str, dict[str, Any]] = OrderedDict()
        self.relay: Any = None

    async def timezone(self, client: Any, binding: dict[str, Any]) -> ZoneInfo:
        try:
            response = await client._request("post", "/settings/get", json={
                "contract_version": 1, "key": binding["timezone"]["key"], "scope": "product",
            })
            response.raise_for_status()
            data = response.json()
            if (type(data["contract_version"]) is not int or data["contract_version"] != 1 or data["scope"] != "product"
                    or data["key"] != binding["timezone"]["key"] or data.get("subject_id") is not None):
                raise ValueError("invalid settings response")
            value = data["value"]
            if (not isinstance(value, str) or not value or value in {"localtime", "posixrules"}
                    or value.startswith(("/", ".", "posix/", "right/"))):
                raise ValueError("invalid timezone")
            return ZoneInfo(value)
        except Exception as error:
            raise BindingRuntimeError("Set a valid product IANA timezone through /settings/set before using these commands.") from error

    def remember(self, update: Any, binding: dict[str, Any], choices: list[dict[str, Any]]) -> InlineKeyboardMarkup:
        if len(choices) > 100 or len(json.dumps([choice["contexts"] for choice in choices]).encode()) > MAX_CONTEXT_BYTES:
            raise BindingRuntimeError("This selection is too large. Please shorten the task or list fewer items.")
        now = self.monotonic()
        for token, entry in list(self.pending.items()):
            if entry["expires"] <= now:
                del self.pending[token]
        while len(self.pending) >= MAX_CONTEXTS:
            self.pending.popitem(last=False)
        token = token_urlsafe(18)
        self.pending[token] = {
            "user": update.effective_user.id, "chat": update.effective_chat.id,
            "binding": binding, "choices": choices, "expires": now + CONTEXT_TTL,
        }
        return InlineKeyboardMarkup([[
            InlineKeyboardButton(choice["call"]["label"], callback_data=f"b1:{token}:{index}")
            for index, choice in enumerate(choices)
        ]])

    async def call(self, client: Any, call: dict[str, Any], contexts: dict[str, Any], user_id: int, zone: ZoneInfo) -> Any:
        action = DATA["actions"][call["action"]]
        arguments = {name: reference(source, contexts) for name, source in call["args"].items()}
        check(action["input"], arguments)
        path = action["operation"]["path"]
        for name in re.findall(r"\{([^}]+)\}", path):
            path = path.replace("{" + name + "}", quote(str(arguments.pop(name)), safe=""))
        method = action["operation"]["method"].lower()
        kwargs = {"params" if method in ("get", "delete") else "json": arguments}
        if method != "get":
            # Each handler owns this client. An uncertain mutation must not be retried.
            client.max_retries = 1
        response = await client.request_as_telegram_user(method, path, user_id, **kwargs)
        response.raise_for_status()
        result = response.json()
        check(action["output"], result)
        return result

    async def command(self, binding: dict[str, Any], command: dict[str, Any], update: Any, context: Any) -> None:
        if (update.effective_user is None or update.effective_chat is None
                or update.message is None):
            return
        try:
            # Splitting once retains task spacing and wording rather than joining context.args.
            message = update.message.text or ""
            text = re.split(r"\s", message, maxsplit=1)[1] if re.search(r"\s", message) else ""
            if command["kind"] == "parsed_create" and not text.strip():
                await update.message.reply_text(bounded(command["on_invalid_text"]))
                return
            if len(text) > MAX_TEXT:
                raise BindingRuntimeError("Please shorten the task to 4000 characters.")
            async with self.client_factory() as client:
                zone = await self.timezone(client, binding)
                if command["kind"] == "parsed_create":
                    now = self.clock()
                    if now.utcoffset() is None:
                        raise BindingRuntimeError("An aware clock is required.")
                    parsed = PARSERS[command["parse"]["function"]](
                        text, lang=command["parse"]["lang"], now=now, tz=zone.key,
                    )
                    if parsed is None:
                        choices = [{"call": preset, "contexts": {"text": text},
                                    "time": preset["time"]}
                                   for preset in command["on_empty"]["presets"]]
                        markup = self.remember(update, binding, choices)
                        await update.message.reply_text(bounded(command["on_empty"]["text"]), reply_markup=markup)
                        return
                    if not isinstance(parsed.get("rest"), str) or not parsed["rest"].strip():
                        await update.message.reply_text(bounded(command["on_invalid_text"]))
                        return
                    result = await self.call(client, command, {"parsed": parsed}, update.effective_user.id, zone)
                    await update.message.reply_text(render(command["reply"], {"result": result}, zone))
                else:
                    items = await self.call(client, command, {}, update.effective_user.id, zone)
                    items = [item for item in items if item[command["filter"]["field"]] == command["filter"]["equals"]]
                    if not items:
                        await update.message.reply_text(bounded(command["on_none"]))
                    for item in items[:100]:
                        choices = [{"call": button, "contexts": {"item": {
                            source.partition(".")[2]: item[source.partition(".")[2]]
                            for source in button["args"].values()
                        }}} for button in command["buttons"]]
                        markup = self.remember(update, binding, choices)
                        await update.message.reply_text(render(command["reply_each"], {"item": item}, zone), reply_markup=markup)
        except BindingRuntimeError as error:
            await update.message.reply_text(bounded(str(error)))
        except Exception:
            await update.message.reply_text(ERROR_REPLY)

    async def callback(self, update: Any, context: Any) -> None:
        query = update.callback_query
        if query is None:
            return
        data = query.data if isinstance(query.data, str) else ""
        match = re.fullmatch(r"b1:([A-Za-z0-9_-]{24}):(\d{1,3})", data)
        entry = self.pending.get(match[1]) if match else None
        if (match is None or entry is None or update.effective_user is None or update.effective_chat is None
                or query.from_user.id != update.effective_user.id
                or entry["expires"] <= self.monotonic()
                or entry["user"] != update.effective_user.id
                or entry["chat"] != update.effective_chat.id
                or int(match[2]) >= len(entry["choices"])):
            await query.answer(STALE_REPLY, show_alert=True)
            return
        # Consume before the first await: concurrent/duplicate selections cannot re-enter.
        del self.pending[match[1]]
        choice = entry["choices"][int(match[2])]
        await query.answer()
        try:
            async with self.client_factory() as client:
                zone = await self.timezone(client, entry["binding"])
                contexts = dict(choice["contexts"])
                if "time" in choice:
                    contexts["preset"] = {"at": preset_at(choice["time"], self.clock(), zone)}
                result = await self.call(client, choice["call"], contexts, update.effective_user.id, zone)
                await query.edit_message_text(render(choice["call"]["reply"], {"result": result}, zone))
        except BindingRuntimeError as error:
            await query.edit_message_text(bounded(str(error)))
        except Exception:
            await query.edit_message_text(ERROR_REPLY)


def register(application: Any, client_factory: Any) -> None:
    runtime = ChannelBindings(client_factory)
    application.bot_data["bindings"] = runtime
    for binding in DATA["bindings"]:
        for command in binding["commands"]:
            async def handler(update: Any, context: Any, binding: Any = binding, command: Any = command) -> None:
                await runtime.command(binding, command, update, context)
            application.add_handler(CommandHandler(command["command"], handler))
    application.add_handler(CallbackQueryHandler(runtime.callback, pattern=r"^b1:"))


async def start(application: Any) -> None:
    from services.tg_bot.src.generated.binding_relay import BindingRelay
    runtime = application.bot_data["bindings"]
    if any(binding["events"] for binding in DATA["bindings"]):
        runtime.relay = BindingRelay(application.bot, runtime)
        try:
            await runtime.relay.start()
        except BaseException:
            await runtime.relay.stop()
            runtime.relay = None
            raise


async def stop(application: Any) -> None:
    runtime = application.bot_data.get("bindings")
    if runtime is not None:
        if runtime.relay is not None:
            await runtime.relay.stop()
            runtime.relay = None
        runtime.pending.clear()
