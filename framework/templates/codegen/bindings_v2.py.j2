"""Finite v2 commands with explicit per-update product language."""

from collections.abc import Callable
from typing import Any, TypeVar
from zoneinfo import ZoneInfo

from httpx import HTTPStatusError, RequestError, TimeoutException
from jsonschema import ValidationError
from telegram.ext import CallbackQueryHandler, CommandHandler

from services.tg_bot.src.generated import bindings_v1 as v1

DATA = v1.DATA
check = v1.check
reference = v1.reference
render = v1.render
start = v1.start
stop = v1.stop
LANGUAGE_SETUP = "Настройте язык продукта (ru/en) через /settings/set. / Set the product language (ru/en) through /settings/set."
TIMEZONE_SETUP = "Настройте часовой пояс продукта IANA через /settings/set. / Set a valid product IANA timezone through /settings/set."
SETTINGS_TEMPORARY = "Настройки временно недоступны. Попробуйте ещё раз. / Settings are temporarily unavailable. Please try again."
STALE = "Выбор устарел, уже использован или принадлежит другому пользователю/чату. Повторите команду. / This selection expired, was already used, or belongs to another user/chat. Run the command again."
ERROR = {
    "ru": "Сервер не подтвердил операцию. Проверьте настройки и список перед повтором.",
    "en": v1.ERROR_REPLY,
}
TOO_LARGE = {
    "ru": "Слишком большой выбор. Сократите текст или список.",
    "en": "This selection is too large. Please shorten the text or list fewer items.",
}
MONTHS_RU = ("января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа",
             "сентября", "октября", "ноября", "декабря")
SettingValueT = TypeVar("SettingValueT")


class ActionError(ValueError):
    def __init__(self, code: str) -> None:
        self.code = code
        super().__init__(code)


class SettingsReadError(v1.BindingRuntimeError):
    def __init__(self, key: str, state: str, reason: str, setup: str) -> None:
        self.key = key
        self.state = state
        self.reason = reason
        super().__init__(setup if state == "setup" else SETTINGS_TEMPORARY)


def language_value(value: Any) -> str:
    if not isinstance(value, str) or value not in ("ru", "en"):
        raise ValueError("invalid language")
    return value


async def read_setting(client: Any, key: str, validate: Callable[[Any], SettingValueT], setup: str) -> SettingValueT:
    """Classify HTTP/transport failures before parsing the product setting contract."""
    try:
        response = await client._request("post", "/settings/get", json={
            "contract_version": 1, "key": key, "scope": "product",
        })
        response.raise_for_status()
    except HTTPStatusError as error:
        status = error.response.status_code
        state = "setup" if 400 <= status < 500 else "transient"
        raise SettingsReadError(key, state, f"http_{status}", setup) from error
    except RequestError as error:
        reason = "timeout" if isinstance(error, TimeoutException) else "transport"
        raise SettingsReadError(key, "transient", reason, setup) from error
    try:
        data = response.json()
        if not isinstance(data, dict):
            raise ValueError("invalid settings response")
        return validate(v1.settings_value(data, key))
    except (ValueError, KeyError, TypeError) as error:
        raise SettingsReadError(key, "setup", "invalid_response_or_value", setup) from error


def localized(text: dict[str, str], language: str) -> str:
    return v1.bounded(text[language])


def display(part: dict[str, Any], contexts: dict[str, Any], zone: ZoneInfo | None,
            language: str) -> str:
    value = reference(part["source"], contexts)
    if part["format"] == "month_word":
        if zone is None:
            raise v1.BindingRuntimeError(TIMEZONE_SETUP)
        local = v1.aware(value).astimezone(zone)
        months = MONTHS_RU if language == "ru" else v1.MONTHS
        at = "в" if language == "ru" else "at"
        return f"{local.day} {months[local.month - 1]} {local.year} {at} {local:%H:%M %Z}"
    return str(value)


def render_v2(reply: dict[str, Any], contexts: dict[str, Any], zone: ZoneInfo | None,
              language: str) -> str:
    return v1.bounded("".join(
        display(part, contexts, zone, language) if "source" in part else part[language]
        for part in reply["parts"]
    ))


class ChannelBindings(v1.ChannelBindings):
    async def language(self, client: Any, binding: dict[str, Any]) -> str:
        return await read_setting(client, binding["language"]["key"], language_value, LANGUAGE_SETUP)

    async def configuration(self, client: Any, binding: dict[str, Any]) -> tuple[str, ZoneInfo | None]:
        language = await self.language(client, binding)
        zone: ZoneInfo | None = None
        if binding["timezone"] is not None:
            zone = await read_setting(client, binding["timezone"]["key"], v1.timezone_value, TIMEZONE_SETUP)
        return language, zone

    async def call_v2(self, client: Any, call: dict[str, Any], contexts: dict[str, Any],
                      user_id: int, zone: Any) -> Any:
        try:
            return await self.call(client, call, contexts, user_id, zone)
        except HTTPStatusError as error:
            if 400 <= error.response.status_code < 500:
                body = error.response.json()
                detail = body.get("detail") if isinstance(body, dict) else None
                code = detail.get("code") if isinstance(detail, dict) else None
                if isinstance(code, str) and code in DATA["actions"][call["action"]].get("errors", []):
                    raise ActionError(code) from error
            raise

    def remember_v2(self, update: Any, binding: dict[str, Any], command: dict[str, Any],
                    item: dict[str, Any], language: str) -> Any:
        choices = v1.item_choices(command, item)
        choices = [{**choice, "call": {**choice["call"],
                    "label": localized(choice["call"]["label"], language)}} for choice in choices]
        try:
            return self.remember(update, binding, choices)
        except v1.BindingRuntimeError as error:
            raise v1.BindingRuntimeError(localized(TOO_LARGE, language)) from error

    async def text_create(self, client: Any, command: dict[str, Any], update: Any,
                          text: str, language: str, zone: Any) -> None:
        if not text.strip():
            await update.message.reply_text(localized(command["on_empty"], language))
            return
        arguments = {name: text for name in command["args"]}
        try:
            check(DATA["actions"][command["action"]]["input"], arguments)
        except ValidationError:
            await update.message.reply_text(localized(command["on_invalid_text"], language))
            return
        try:
            result = await self.call_v2(client, command, {"text": text}, update.effective_user.id, zone)
        except ActionError as error:
            await update.message.reply_text(localized(command["on_error"].get(error.code, ERROR), language))
            return
        await update.message.reply_text(render_v2(command["reply"], {"result": result}, zone, language))

    async def list_v2(self, client: Any, binding: dict[str, Any], command: dict[str, Any],
                      update: Any, language: str, zone: Any) -> None:
        items = await self.call_v2(client, command, {}, update.effective_user.id, zone)
        item_filter = command["filter"]
        if item_filter is not None:
            items = [item for item in items if item[item_filter["field"]] == item_filter["equals"]]
        if not items:
            await update.message.reply_text(localized(command["on_none"], language))
        for item in items[:100]:
            markup = self.remember_v2(update, binding, command, item, language) if command["buttons"] else None
            await update.message.reply_text(
                render_v2(command["reply_each"], {"item": item}, zone, language), reply_markup=markup,
            )

    async def execute_v2(self, client: Any, binding: dict[str, Any], command: dict[str, Any],
                         update: Any, language: str, zone: Any) -> None:
        text = v1.command_text(update)
        if len(text) > v1.MAX_TEXT:
            key = "on_invalid_text" if command["kind"] == "text_create" else "help"
            await update.message.reply_text(localized(command[key], language))
        elif command["kind"] == "text_create":
            await self.text_create(client, command, update, text, language, zone)
        elif text.strip():
            await update.message.reply_text(localized(command["help"], language))
        else:
            await self.list_v2(client, binding, command, update, language, zone)

    async def command(self, binding: dict[str, Any], command: dict[str, Any], update: Any, context: Any) -> None:
        if binding["binding_version"] == 1:
            await super().command(binding, command, update, context)
            return
        if update.effective_user is None or update.effective_chat is None or update.message is None:
            return
        failure = SETTINGS_TEMPORARY
        try:
            async with self.client_factory() as client:
                language, zone = await self.configuration(client, binding)
                failure = localized(ERROR, language)
                await self.execute_v2(client, binding, command, update, language, zone)
        except v1.BindingRuntimeError as error:
            await update.message.reply_text(v1.bounded(str(error)))
        except Exception:
            await update.message.reply_text(failure)

    async def callback_v2(self, update: Any, entry: dict[str, Any], choice: dict[str, Any]) -> None:
        query = update.callback_query
        failure = SETTINGS_TEMPORARY
        try:
            async with self.client_factory() as client:
                language, zone = await self.configuration(client, entry["binding"])
                failure = localized(ERROR, language)
                result = await self.call_v2(client, choice["call"], choice["contexts"], update.effective_user.id, zone)
                await query.edit_message_text(render_v2(choice["call"]["reply"], {"result": result}, zone, language))
        except v1.BindingRuntimeError as error:
            await query.edit_message_text(v1.bounded(str(error)))
        except Exception:
            await query.edit_message_text(failure)

    async def callback(self, update: Any, context: Any) -> None:
        query = update.callback_query
        if query is None:
            return
        # Inspect only to route; the owner/expiry check and consume stay in the v1 primitive.
        data = query.data if isinstance(query.data, str) else ""
        entry = self.pending.get(data.split(":")[1]) if data.count(":") == 2 else None
        if entry is not None and entry["binding"]["binding_version"] == 1:
            await super().callback(update, context)
            return
        selection = self.callback_choice(update)
        if selection is None:
            await query.answer(STALE, show_alert=True)
            return
        entry, choice = selection
        await query.answer()
        await self.callback_v2(update, entry, choice)

    async def event_text(self, binding: dict[str, Any], event: dict[str, Any], payload: dict[str, Any]) -> str:
        async with self.client_factory() as client:
            if binding["binding_version"] == 2:
                language, zone = await self.configuration(client, binding)
                return render_v2(event["reply"], {"event": payload}, zone, language)
            zone = None
            if any(isinstance(part, dict) and part.get("format") == "month_word" for part in event["reply"]["parts"]):
                zone = await self.timezone(client, binding)
            return render(event["reply"], {"event": payload}, zone)


def register(application: Any, client_factory: Any) -> None:
    runtime = ChannelBindings(client_factory)
    application.bot_data["bindings"] = runtime
    for binding in DATA["bindings"]:
        for command in binding["commands"]:
            async def handler(update: Any, context: Any, binding: Any = binding, command: Any = command) -> None:
                await runtime.command(binding, command, update, context)
            application.add_handler(CommandHandler(command["command"], handler))
    application.add_handler(CallbackQueryHandler(runtime.callback, pattern=r"^b1:"))
